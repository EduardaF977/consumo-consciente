.env
.env.local
.env.*.local

# ── Builds e arquivos gerados ────────────────────────────────────────────────
dist/
build/

# ── Cache Vite ───────────────────────────────────────────────────────────────
.vite/

# ── Prisma — cliente gerado (regenerado via prisma generate) ─────────────────
